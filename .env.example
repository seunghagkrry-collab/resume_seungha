# 이 파일을 복사해서 .env 를 만들고, 진짜 값을 채워 넣어요.
# .env 파일은 절대 git에 올리면 안 돼요 (이미 .gitignore에 등록돼 있어요).

# 관리자 로그인 비밀번호 (처음 한 번만 설정하면 이후엔 자동 생성된 값을 써도 됨)
ADMIN_PASSWORD=

# Supabase 프로젝트 설정 → API 메뉴에서 복사
# Project URL
SUPABASE_URL=
# service_role 키 (secret, 절대 공개하지 않기)
SUPABASE_SERVICE_ROLE_KEY=

# (기존) Vercel Blob을 계속 쓸 경우에만 필요
BLOB_READ_WRITE_TOKEN=
